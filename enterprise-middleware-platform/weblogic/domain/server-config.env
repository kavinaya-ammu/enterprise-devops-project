# WebLogic Domain
DOMAIN_NAME=enterprise_domain

# Administration Server
ADMIN_SERVER_NAME=AdminServer
ADMIN_SERVER_PORT=7001

# Cluster
CLUSTER_NAME=Cluster1

# Managed Server 1
MS1_NAME=ManagedServer1
MS1_PORT=8001

# Managed Server 2
MS2_NAME=ManagedServer2
MS2_PORT=8002

# Managed Server 3
MS3_NAME=ManagedServer3
MS3_PORT=8003

# Application
APPLICATION_NAME=enterprise-admin-app
APPLICATION_TYPE=WAR

# Database
DATABASE_TYPE=PostgreSQL
JDBC_ENABLED=true
