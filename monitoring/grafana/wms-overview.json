{
  "uid": "enterprise-wms-overview",
  "title": "Enterprise WMS Overview",
  "tags": ["wms", "devops"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Prometheus target up", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "up", "legendFormat": "{{job}} / {{instance}}", "refId": "A"}]},
    {"id": 2, "type": "timeseries", "title": "JVM heap used", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "jvm_memory_used_bytes{area="heap"}", "legendFormat": "{{instance}}", "refId": "A"}]},
    {"id": 3, "type": "timeseries", "title": "HTTP request rate", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "sum by (uri, method) (rate(http_server_requests_seconds_count[5m]))", "legendFormat": "{{method}} {{uri}}", "refId": "A"}]},
    {"id": 4, "type": "timeseries", "title": "HTTP 5xx rate", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{status=~"5.."}[5m]))", "legendFormat": "5xx/s", "refId": "A"}]}
  ]
}
